extends Resource
## Precomputed convex hulls for a vehicle body, in body-local space.
## Generated by `res://scripts/vehicles/bake_hulls.gd` so runtime spawn
## does not call Mesh.create_convex_shape (which stalls the main thread
## for many seconds per car / plane).
class_name BakedHulls

@export var hull_names: PackedStringArray = PackedStringArray()
@export var hull_transforms: Array[Transform3D] = []
@export var hull_points: Array[PackedVector3Array] = []


func hull_count() -> int:
	return mini(hull_names.size(), mini(hull_transforms.size(), hull_points.size()))
